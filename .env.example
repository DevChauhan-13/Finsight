# FinSight Environment Configuration Template

# -------------------------------------------------------------
# Hindsight Persistent Agent Memory Configuration
# -------------------------------------------------------------
# URL of running Hindsight service (Docker, Kubernetes, or Cloud)
HINDSIGHT_API_URL=http://localhost:8888

# Optional API key for Hindsight if authentication is enabled
HINDSIGHT_API_KEY=

# Isolated Memory Bank ID for Financial Reconciliation Exceptions
HINDSIGHT_BANK_ID=finsight-finance-reconciliation

# -------------------------------------------------------------
# LLM Integration (Optional - for Gemini schema normalization & drafting)
# -------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Note: The system features 100% offline rule-based and local-memory fallbacks,
# allowing full reconciliation, exception detection, and tests to pass
# without external API dependencies.
